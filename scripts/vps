#!/usr/bin/env bash
# vps - resilient remote command runner for the LoraHub VPS.
#
# Why: AutoDL's sshd drops idle sockets aggressively (we keep seeing
# "Connection closed by 198.18.0.32"). Every command run via plain ssh
# turned into a coin flip. This wrapper:
#
#   1. Retries the SSH dial up to 5 times with backoff.
#   2. Forces ServerAliveInterval / Max so the socket survives bursty
#      networks.
#   3. Provides a `bg` subcommand that runs anything detached on the
#      remote via setsid+nohup, so a dropped SSH connection no longer
#      kills the running task. Output is logged to /root/_<sess>.log.
#   4. Provides `wait` to block-poll a remote bg session until done.
#   5. Provides `tail`, `put`, `exec` for ergonomic one-shots.
#
# Usage:
#   scripts/vps exec '<cmd>'                      # one-shot, retried
#   scripts/vps put <local> <remote>              # scp w/ retries
#   scripts/vps bg <session> '<cmd>'              # detach + run, log
#                                                 # to /root/_<sess>.log
#   scripts/vps wait <session>                    # block until session
#                                                 # exits, prints log
#   scripts/vps tail <session>                    # tail -f the log
#   scripts/vps log <session>                     # cat the log
#   scripts/vps kill <session>                    # kill the bg pid
#   scripts/vps status                            # health + uvicorn pid
#
# Required env (LORAHUB_REMOTE_PASS is the only mandatory one):
#   LORAHUB_REMOTE_HOST  default: connect.westc.seetacloud.com
#   LORAHUB_REMOTE_PORT  default: 45300
#   LORAHUB_REMOTE_USER  default: root
#   LORAHUB_REMOTE_DIR   default: /root/autodl-tmp/LoraHub
#   LORAHUB_REMOTE_PASS  the SSH password (or pipe on stdin)

set -euo pipefail

HOST="${LORAHUB_REMOTE_HOST:-connect.westc.seetacloud.com}"
PORT="${LORAHUB_REMOTE_PORT:-45300}"
USER="${LORAHUB_REMOTE_USER:-root}"
DIR="${LORAHUB_REMOTE_DIR:-/root/autodl-tmp/LoraHub}"
NODE_BIN="${LORAHUB_REMOTE_NODE:-/root/autodl-tmp/opt/node20/bin}"

# Sane remote PATH — never inherit Windows-mixed PATH from WSL interop.
REMOTE_PATH="${NODE_BIN}:/root/.local/bin:/root/miniconda3/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# SSH options tuned for AutoDL: tight handshake timeout, frequent
# keepalives so an idle socket doesn't get axed mid-command.
SSH_OPTS=(
  -o StrictHostKeyChecking=no
  -o UserKnownHostsFile=/dev/null
  -o LogLevel=ERROR
  -o ConnectTimeout=10
  -o ConnectionAttempts=3
  -o ServerAliveInterval=15
  -o ServerAliveCountMax=4
  -o TCPKeepAlive=yes
  -p "$PORT"
)
SCP_OPTS=(
  -o StrictHostKeyChecking=no
  -o UserKnownHostsFile=/dev/null
  -o LogLevel=ERROR
  -o ConnectTimeout=10
  -o ServerAliveInterval=15
  -P "$PORT"
)

read_pass() {
  if [[ -n "${LORAHUB_REMOTE_PASS:-}" ]]; then return 0; fi
  if [[ ! -t 0 ]]; then
    LORAHUB_REMOTE_PASS="$(cat)"
    LORAHUB_REMOTE_PASS="${LORAHUB_REMOTE_PASS%%$'\n'*}"
  fi
  if [[ -z "${LORAHUB_REMOTE_PASS:-}" ]]; then
    echo "vps: LORAHUB_REMOTE_PASS not set" >&2
    exit 2
  fi
  export LORAHUB_REMOTE_PASS
}

require_sshpass() {
  if ! command -v sshpass >/dev/null 2>&1; then
    echo "vps: sshpass not installed (apt install sshpass)" >&2
    exit 2
  fi
}

# Run `ssh ...` with sshpass + retry. Each retry sleeps 2,4,8,12,16s.
ssh_retry() {
  local last=1
  for attempt in 1 2 3 4 5; do
    if SSHPASS="${LORAHUB_REMOTE_PASS}" sshpass -e ssh "${SSH_OPTS[@]}" "${USER}@${HOST}" "$@"; then
      return 0
    fi
    last=$?
    if [[ $attempt -lt 5 ]]; then
      local sleep_s=$((attempt * 2 + 2))
      echo "vps: ssh failed (exit $last), retry $((attempt + 1))/5 in ${sleep_s}s" >&2
      sleep "$sleep_s"
    fi
  done
  return $last
}

scp_retry() {
  local last=1
  for attempt in 1 2 3 4 5; do
    if SSHPASS="${LORAHUB_REMOTE_PASS}" sshpass -e scp "${SCP_OPTS[@]}" "$@"; then
      return 0
    fi
    last=$?
    if [[ $attempt -lt 5 ]]; then
      local sleep_s=$((attempt * 2 + 2))
      echo "vps: scp failed (exit $last), retry $((attempt + 1))/5 in ${sleep_s}s" >&2
      sleep "$sleep_s"
    fi
  done
  return $last
}

# `exec` — run a single command on the remote with the canonical PATH +
# project working directory. Output streams back live. Retries on
# connect failure; once a command actually starts running we don't
# retry it (could double-execute side effects).
cmd_exec() {
  if [[ $# -lt 1 ]]; then
    echo "usage: vps exec '<command>'" >&2
    exit 1
  fi
  local cmd="$*"
  ssh_retry "export PATH=${REMOTE_PATH}; cd ${DIR} 2>/dev/null || true; ${cmd}"
}

# `put` — scp a local file to the remote.
cmd_put() {
  if [[ $# -lt 2 ]]; then
    echo "usage: vps put <local-path> <remote-path>" >&2
    exit 1
  fi
  scp_retry "$1" "${USER}@${HOST}:$2"
}

# `bg` — kick off a long-running command in the background on the
# remote. Uses setsid + nohup so the process survives our SSH socket
# closing. PID + completion are tracked via /root/_<session>.{pid,done};
# stdout+stderr stream to /root/_<session>.log. Re-running with the
# same session name kills the previous instance first so callers don't
# accidentally double-start work.
cmd_bg() {
  if [[ $# -lt 2 ]]; then
    echo "usage: vps bg <session-name> '<command>'" >&2
    exit 1
  fi
  local session="$1"; shift
  local cmd="$*"
  local logfile="/root/_${session}.log"
  local pidfile="/root/_${session}.pid"
  local donefile="/root/_${session}.done"
  # Single-quoted heredoc so $vars stay literal until expanded by the
  # remote shell. We deliberately re-export PATH on the remote — the
  # caller's command may rely on it.
  local script
  script=$(cat <<EOF
export PATH=${REMOTE_PATH}
cd ${DIR} 2>/dev/null || true
# Kill any prior instance under this name and wipe its state files.
if [[ -f ${pidfile} ]]; then
  old=\$(cat ${pidfile} 2>/dev/null || true)
  [[ -n "\$old" ]] && kill -9 "\$old" 2>/dev/null || true
fi
rm -f ${logfile} ${pidfile} ${donefile}
# setsid detaches from the controlling terminal so the SSH disconnect
# doesn't cascade SIGHUP. The wrapper writes the PID, runs the command,
# then touches the done-marker so wait/poll can tell it's finished.
setsid bash -c '
  echo "\$\$" > ${pidfile}
  ( ${cmd} ) </dev/null >${logfile} 2>&1
  rc=\$?
  echo "exit=\$rc" > ${donefile}
' </dev/null >/dev/null 2>&1 &
disown 2>/dev/null || true
sleep 0.5
if [[ -f ${pidfile} ]]; then
  echo "started session=${session} pid=\$(cat ${pidfile}) log=${logfile}"
else
  echo "ERROR: ${pidfile} not created"
  exit 1
fi
EOF
)
  ssh_retry "$script"
}

# `wait` — block until the named bg session exits, then print the tail
# of its log. Polls every 5s; survives transient SSH drops via
# ssh_retry.
cmd_wait() {
  if [[ $# -lt 1 ]]; then
    echo "usage: vps wait <session-name>" >&2
    exit 1
  fi
  local session="$1"
  local logfile="/root/_${session}.log"
  local donefile="/root/_${session}.done"
  echo "vps: waiting for session ${session} ..." >&2
  while ! ssh_retry "test -f ${donefile}" >/dev/null 2>&1; do
    sleep 5
  done
  ssh_retry "echo === ${session} done ===; cat ${donefile}; echo; echo === tail of log ===; tail -40 ${logfile}"
}

# `tail` — `tail -f` the session log. Quitting (Ctrl-C) doesn't kill
# the remote command.
cmd_tail() {
  if [[ $# -lt 1 ]]; then
    echo "usage: vps tail <session-name>" >&2
    exit 1
  fi
  local session="$1"
  local logfile="/root/_${session}.log"
  ssh_retry "tail -f ${logfile}"
}

cmd_log() {
  if [[ $# -lt 1 ]]; then
    echo "usage: vps log <session-name>" >&2
    exit 1
  fi
  local session="$1"
  local logfile="/root/_${session}.log"
  ssh_retry "cat ${logfile}"
}

cmd_kill() {
  if [[ $# -lt 1 ]]; then
    echo "usage: vps kill <session-name>" >&2
    exit 1
  fi
  local session="$1"
  local pidfile="/root/_${session}.pid"
  ssh_retry "if [[ -f ${pidfile} ]]; then pid=\$(cat ${pidfile}); kill -9 \"\$pid\" 2>/dev/null && echo killed pid=\$pid || echo not_running pid=\$pid; rm -f ${pidfile}; else echo no_pidfile; fi"
}

cmd_status() {
  ssh_retry "echo === uvicorn ===; \
    pgrep -fa 'uvicorn lorahub.api.app' || echo no_uvicorn; \
    echo; echo === health ===; \
    curl -fsS --max-time 5 http://127.0.0.1:6006/api/health 2>&1 | head -c 200 || echo unreachable; \
    echo; echo; echo === bg sessions ===; \
    ls -1 /root/_*.pid 2>/dev/null | sed 's|/root/_||;s|\.pid||' | while read -r s; do \
      pid=\$(cat /root/_\$s.pid 2>/dev/null); \
      if kill -0 \"\$pid\" 2>/dev/null; then echo \"  \$s pid=\$pid running\"; \
      elif [[ -f /root/_\$s.done ]]; then echo \"  \$s done (\$(cat /root/_\$s.done))\"; \
      else echo \"  \$s pid=\$pid stopped\"; fi; \
    done"
}

cmd_health() {
  ssh_retry "curl -fsS --max-time 5 http://127.0.0.1:6006/api/health"
}

usage() {
  sed -n '2,30p' "$0"
  exit "${1:-1}"
}

main() {
  if [[ $# -lt 1 ]]; then usage; fi
  read_pass
  require_sshpass
  local sub="$1"; shift
  case "$sub" in
    exec)   cmd_exec "$@" ;;
    put)    cmd_put "$@" ;;
    bg)     cmd_bg "$@" ;;
    wait)   cmd_wait "$@" ;;
    tail)   cmd_tail "$@" ;;
    log)    cmd_log "$@" ;;
    kill)   cmd_kill "$@" ;;
    status) cmd_status ;;
    health) cmd_health ;;
    *) usage 1 ;;
  esac
}

main "$@"
