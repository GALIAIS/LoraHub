# LoraHub docker-compose environment
# Copy to .env (next to docker-compose.yml) and edit. All values optional.
# Lines left blank = use upstream defaults.

# ── Networking ───────────────────────────────────────────────────────
# Host-side bind address. Default 127.0.0.1. Use TLS when exposing it.
LORAHUB_BIND_ADDR=127.0.0.1
LORAHUB_PORT=18765
# Optional fixed API token. Blank generates one in the persistent data volume.
LORAHUB_API_TOKEN=

# ── Locale / timezone ────────────────────────────────────────────────
LORAHUB_LANG=zh
TZ=Asia/Shanghai

# ── Volume ownership (linuxserver-style) ─────────────────────────────
# The container creates a `lorahub` user with these UID/GID and chowns
# /data to it. Match the host user that owns the dataset/model dirs
# you bind-mount (id -u / id -g on Linux).
PUID=1000
PGID=1000

# ── GPU ──────────────────────────────────────────────────────────────
# Number of GPUs to expose to the default (GPU) service. `all` or an int.
LORAHUB_GPU_COUNT=all

# ── Mirror sources (China / restricted networks) ────────────────────
# Leave empty to use upstream. Examples below are the TUNA / npmmirror /
# gh-proxy set used by scripts/install-cn.sh.
# LORAHUB_PYPI_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
# LORAHUB_GH_PROXY=https://gh-proxy.org/
# NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
LORAHUB_PYPI_INDEX=
LORAHUB_GH_PROXY=
NPM_CONFIG_REGISTRY=

# ── Hugging Face ─────────────────────────────────────────────────────
# Endpoint override (e.g. https://hf-mirror.com for the China mirror).
# Token for gated models / higher rate limits (WD14, SDXL base, …).
HF_ENDPOINT=
HF_TOKEN=

# ── CORS (optional) ──────────────────────────────────────────────────
# Comma-separated extra allowed origins if you run the Vite dev server
# against the containerised API. The built-in local-dev origins are
# always allowed.
LORAHUB_ALLOWED_ORIGINS=
