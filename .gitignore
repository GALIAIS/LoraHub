# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Backend-specific vendored venvs (auto-bootstrapped)
.lorahub/
backends_venvs/

# Testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
.vite/

# LoraHub runtime artifacts
workspaces/
runs/
checkpoints/
samples/
_smoke/
*.safetensors
*.ckpt
*.pt
!tests/fixtures/**/*.safetensors

# Datasets (user data, never commit)
datasets/
!tests/fixtures/datasets/
!web/src/pages/datasets/

# Bundled kohya checkout (cloned by `lorahub bootstrap-kohya`, never committed)
sd-scripts/

# Logs
*.log
logs/

# mkdocs build output
site/

# OS
Thumbs.db
desktop.ini

# Secrets
.env
.env.*
!.env.example
tsconfig.tsbuildinfo
diffusion-pipe/
.cloud-*.sh
.remote-*.sh
.wsl-*.sh

# hatch-vcs writes the resolved version here at build/install time;
# committing it would drift behind whatever tag is current.
lorahub/_version.py

# Local dev scratch — ad-hoc temp scripts, claude/agent worktrees,
# and stdout/err captures from launch-dev style helpers. Stays
# out of git so the repo doesn't accumulate per-machine debris.
.tmp_*
.claude/
*-local.err
*-local.out
