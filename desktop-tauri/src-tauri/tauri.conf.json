{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoraHub",
  "version": "0.1.0",
  "identifier": "com.galiais.lorahub.desktop",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": "all",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
