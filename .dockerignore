# ── LoraHub .dockerignore ─────────────────────────────────────────────
# This file MUST live at the build-context root (repo root) for Docker
# to load it — `docker build -f docker/Dockerfile .` reads .dockerignore
# from the context root (.), not from next to the Dockerfile. See:
# https://docs.docker.com/build/concepts/context/#dockerignore-files
#
# Keep the build context lean: exclude local runtime state, user data,
# and toolchain caches that should never bake into the image. The image
# carries *source* + *built SPA* + *main venv* only — everything under
# LORAHUB_HOME (runs/, models/, .lorahub/, …) is a runtime volume.

# ── Python ──
**/__pycache__/
**/*.py[cod]
**/*.so
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/
**/*.egg-info/
**/.eggs/
# hatch-vcs regenerates this from git tags at build time; shipping a
# stale copy would drift behind the current tag.
lorahub/_version.py

# ── LoraHub managed toolchains & backend venvs (runtime, not image) ──
.lorahub/
.venv/
.node/
.tools/
.cache/
# kohya / diffusion-pipe checkouts (bootstrapped at runtime)
sd-scripts/
diffusion-pipe/
# Backend venvs inside vendored external/ — the source ships, the venv
# is regenerated by `uv sync` against a mounted volume.
external/anima_lora/.venv/
external/ai_toolkit/venv/
external/anima_lora/.codex
external/anima_lora/anima_lora.egg-info/
external/anima_lora/output/
external/anima_lora/post_image_dataset/

# ── LoraHub user data & runtime artefacts ──
runs/
workspaces/
checkpoints/
samples/
_smoke/
datasets/
models/
backends_venvs/
*.safetensors
*.ckpt
*.pt
*.log
logs/
# Local dev scratch
.tmp_*
*-local.err
*-local.out
.claude/

# ── Frontend build output & deps (rebuilt in the web-build stage) ──
web/node_modules/
web/dist/
web/.vite/
web/_npm_install.log
web/scripts/probe-*.mjs
web/scripts/perf-route-*.mjs
web/scripts/datasets-stuck.png
web/scripts/probe-*.png
web/datasets-probe-output.txt

# ── Docs site build (regenerated by mkdocs if needed) ──
site/

# ── Git & IDE ──
.git/
.gitignore
.gitattributes
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Secrets ──
.env
.env.*
!.env.example
docker/.env

# ── Docker artefacts that don't belong in the image ──
# (Dockerfile + entrypoint.sh + docker-compose.yml ARE needed in context;
# docker/README.md is docs-only and harmless but excluded to stay lean.)
docker/README.md
