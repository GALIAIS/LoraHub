# LoraHub environment configuration
# Copy this file to `.env` and edit, OR export these variables in your shell.
# `.env` is gitignored.

# Where your kohya-ss/sd-scripts checkout lives.
# This is the only required setting if you don't want to put backend.sd_scripts_path in every config.
LORAHUB_KOHYA_SD_SCRIPTS=./sd-scripts

# (Optional) Override the Python interpreter that runs kohya. Defaults to the venv inside sd-scripts.
# LORAHUB_KOHYA_PYTHON=E:\WorkSpace\Lora Scripts\sd-scripts\venv\Scripts\python.exe

# (Optional) Hugging Face token for higher rate limits and gated models (WD14 / SDXL base, etc.)
# HF_TOKEN=hf_xxxxxxxxxxxx
